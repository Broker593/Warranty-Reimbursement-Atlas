{
 "schema": 1,
 "name": "Audit climate score",
 "description": "How restrictive state law is toward a manufacturer's or distributor's warranty audits, chargebacks and retail-rate validation, from 14 statutory limits. Higher = more restrictive. Statute text only; not legal advice and not an assessment of any company's audit program.",
 "checked": "2026-09-27",
 "max": 100,
 "factors": [
  {
   "id": "lookback",
   "label": "Short audit and chargeback lookback",
   "max": 15,
   "how": "15 points if paid claims can be audited or charged back for 6 months or less, 10 for 9 months, 5 for 12 months, 0 if the statute sets no limit."
  },
  {
   "id": "stay",
   "label": "Chargeback held while the dealer appeals",
   "max": 15,
   "how": "The chargeback cannot be collected until the dealer's appeal, protest or hearing is resolved."
  },
  {
   "id": "extrap",
   "label": "Limits on extrapolating audit results",
   "max": 10,
   "how": "10 points if projecting sample results across claims is prohibited, 5 if restricted (e.g., only from a valid random sample)."
  },
  {
   "id": "clerical",
   "label": "No chargebacks for clerical or paperwork errors",
   "max": 10,
   "how": "Claims cannot be denied or charged back solely for clerical, administrative or technical errors when the work was done properly."
  },
  {
   "id": "docs",
   "label": "Limits on documentation requirements",
   "max": 5,
   "how": "Documentation demands are limited (e.g., only reasonable written requirements in effect when the claim was paid)."
  },
  {
   "id": "written",
   "label": "Written reasons required before a chargeback",
   "max": 5,
   "how": "The dealer must get written notice of the specific grounds for each chargeback."
  },
  {
   "id": "response",
   "label": "Dealer response or cure period",
   "max": 5,
   "how": "The dealer gets a set period to respond, rebut or cure before the chargeback."
  },
  {
   "id": "appeal",
   "label": "Internal appeal required",
   "max": 5,
   "how": "The manufacturer or distributor must offer an internal appeal or review."
  },
  {
   "id": "selection",
   "label": "Must tell the dealer why it was selected",
   "max": 5,
   "how": "The dealer must be told the basis for selecting it for audit (in some states only for certain audits)."
  },
  {
   "id": "notice",
   "label": "Advance written notice of audit",
   "max": 5,
   "how": "Written notice is required before an audit begins."
  },
  {
   "id": "frequency",
   "label": "Cap on how often audits can occur",
   "max": 5,
   "how": "The statute limits how often a dealer can be audited."
  },
  {
   "id": "nofraud",
   "label": "No fraud carve-out from the time limit",
   "max": 5,
   "how": "The lookback limit applies even to suspected fraud."
  },
  {
   "id": "rate",
   "label": "Rate validation limited to the dealer's submission",
   "max": 5,
   "how": "A retail-rate submission can be checked only against the dealer's own submitted ROs or by a single accuracy objection; no request for more ROs or outside data."
  },
  {
   "id": "conseq",
   "label": "Specific consequence for improper audits",
   "max": 5,
   "how": "The statute attaches a specific consequence to improper audits or chargebacks (void chargeback, violation finding, fines, interest or audit-cost reimbursement)."
  }
 ],
 "tiers": [
  {
   "name": "Very high",
   "min": 50,
   "range": "50+"
  },
  {
   "name": "High",
   "min": 40,
   "range": "40–49"
  },
  {
   "name": "Elevated",
   "min": 30,
   "range": "30–39"
  },
  {
   "name": "Moderate",
   "min": 20,
   "range": "20–29"
  },
  {
   "name": "Low",
   "min": 0,
   "range": "under 20"
  }
 ],
